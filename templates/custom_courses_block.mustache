{{!
    @template theme_president/custom_courses_block

    Custom courses block for theme frontpage.
}}
<section id="frontpage-custom-courses" class="custom-courses-section py-5 bg-light">
    <div class="president-container-fluid">
        <div class="section-header text-center mb-5">
            <span class="section-badge">{{#str}}explorecourses, theme_president{{/str}}</span>
            <h2 class="section-title"><span class="text-gradient" data-text="{{frontpage_courses_title}}">{{frontpage_courses_title}}</span></h2>
        </div>
        <div class="row">
            <div class="d-flex flex-wrap justify-content-start w-100">
                {{#frontpage_courses}}
                    {{> theme_president/president_coursecard }}
                {{/frontpage_courses}}
            </div>
            {{^frontpage_courses}}
                <div class="col-12 text-center text-muted">
                    <p>{{#str}}nocoursesfound, theme_president{{/str}}</p>
                </div>
            {{/frontpage_courses}}
        </div>

        {{#show_view_all}}
        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="{{view_all_url}}" class="btn btn-lg btn-primary">
                    View All {{total_courses}} Courses
                    <i class="fa fa-arrow-right ml-2"></i>
                </a>
            </div>
        </div>
        {{/show_view_all}}
    </div>
</section>
