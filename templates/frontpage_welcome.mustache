{{!
    @template theme_president/frontpage_welcome
    Welcome section for logged-in users - Clean Design with Professional Graphics
}}

<section class="frontpage-welcome-section py-5">
    <div class="president-container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="welcome-content">
                    <h2 class="welcome-title mb-3">
                        {{greeting_time}}, {{user_firstname}}
                    </h2>
                    <p class="welcome-subtitle text-muted mb-4">
                        Welcome back to {{site_fullname}}
                    </p>

                    <div class="quick-stats-grid">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-book"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{active_courses_count}}</div>
                                <div class="stat-label">Active Courses</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-tasks"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{pending_assignments}}</div>
                                <div class="stat-label">Pending Tasks</div>
                            </div>
                        </div>

                        {{#new_messages}}
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{new_messages}}</div>
                                <div class="stat-label">New Messages</div>
                            </div>
                        </div>
                        {{/new_messages}}
                    </div>

                    <div class="welcome-actions mt-4">
                        <a href="{{dashboard_url}}" class="btn btn-primary">
                            Go to Dashboard
                        </a>
                        <a href="{{my_courses_url}}" class="btn btn-outline-secondary">
                            View My Courses
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="welcome-visual">
                    <svg class="welcome-icon" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background circle -->
                        <circle cx="100" cy="100" r="90" fill="#f0f4ff" stroke="#e8eef8" stroke-width="2"/>

                        <!-- Book stack -->
                        <rect x="60" y="70" width="80" height="15" fill="#0f47ad" rx="2"/>
                        <rect x="60" y="90" width="75" height="15" fill="#1a5ad8" rx="2"/>
                        <rect x="60" y="110" width="70" height="15" fill="#2a6ae6" rx="2"/>

                        <!-- Checkmark -->
                        <circle cx="140" cy="140" r="20" fill="#28a745"/>
                        <polyline points="133,140 138,145 147,135" stroke="white" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>
