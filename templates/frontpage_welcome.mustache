{{!
    @template theme_president/frontpage_welcome
    Welcome section with REAL activity chart from user logs
}}

<section class="frontpage-welcome-section py-5">
    <div class="president-container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="welcome-content">
                    <h2 class="welcome-title mb-3">
                        {{greeting_time}}, {{user_firstname}}
                    </h2>
                    <p class="welcome-subtitle text-muted mb-4">
                        Welcome back to {{site_fullname}}
                    </p>

                    <div class="quick-stats-grid">
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-book"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{active_courses_count}}</div>
                                <div class="stat-label">Active Courses</div>
                            </div>
                        </div>

                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-tasks"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{pending_assignments}}</div>
                                <div class="stat-label">Pending Tasks</div>
                            </div>
                        </div>

                        {{#new_messages}}
                        <div class="stat-item">
                            <div class="stat-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <div class="stat-info">
                                <div class="stat-value">{{new_messages}}</div>
                                <div class="stat-label">New Messages</div>
                            </div>
                        </div>
                        {{/new_messages}}
                    </div>

                    <div class="welcome-actions mt-4">
                        <a href="{{dashboard_url}}" class="btn btn-primary">
                            Go to Dashboard
                        </a>
                        <a href="{{my_courses_url}}" class="btn btn-outline-secondary">
                            View My Courses
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="activity-chart-container">
                    <h5 class="chart-title">Your Activity (Last 7 Days)</h5>
                    <div class="activity-chart" id="activityChart" data-activity="{{activity_data}}" data-labels="{{activity_labels}}" data-max="{{max_activity}}"></div>
                </div>
            </div>
        </div>
    </div>
</section>

{{#js}}
require(['jquery'], function($) {
    var chartEl = $('#activityChart');
    var data = JSON.parse(chartEl.attr('data-activity'));
    var labels = JSON.parse(chartEl.attr('data-labels'));
    var max = parseInt(chartEl.attr('data-max'));

    var html = '<div class="chart-bars">';
    for (var i = 0; i < data.length; i++) {
        var height = max > 0 ? (data[i] / max) * 100 : 0;
        html += '<div class="chart-bar-wrapper">';
        html += '<div class="chart-bar" style="height: ' + height + '%">';
        html += '<span class="bar-value">' + data[i] + '</span>';
        html += '</div>';
        html += '<div class="bar-label">' + labels[i] + '</div>';
        html += '</div>';
    }
    html += '</div>';

    chartEl.html(html);
});
{{/js}}
