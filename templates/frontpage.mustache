{{!
    @template theme_president/frontpage

    Frontpage template for PresUniv eCampus.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "addblockbutton": ""
    }
}}
{{> theme_president/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_president/navbar }}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container bg-white">

        {{! ============================== }}
        {{! HERO SLIDER SECTION }}
        {{! ============================== }}
        {{#slidercount}}
            <section id="presidentslideshow" class="hero-section">
                <div id="carousel-indicators" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
                    {{^slidersingleslide}}
                    <ol class="carousel-indicators">
                        {{#slides}}
                            <li data-bs-target="#carousel-indicators" data-bs-slide-to="{{{ key }}}" {{#active}}class="active"{{/active}}></li>
                        {{/slides}}
                    </ol>
                    {{/slidersingleslide}}
                    <div class="carousel-inner">
                        {{#slides}}
                            <div class="carousel-item {{#active}}active{{/active}}">
                                <div class="hero-overlay"></div>
                                <img src="{{image}}" alt="{{slidertitle}}" class="w-100">
                            </div>
                        {{/slides}}
                    </div>
                    {{^slidersingleslide}}
                    <a class="carousel-control-prev" href="#carousel-indicators" role="button" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">{{#str}}previous{{/str}}</span>
                    </a>
                    <a class="carousel-control-next" href="#carousel-indicators" role="button" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">{{#str}}next{{/str}}</span>
                    </a>
                    {{/slidersingleslide}}
                </div>
                {{! Hero content pinned to bottom, outside carousel-inner for consistent position }}
                <div class="hero-content">
                    <div class="hero-cta">
                        {{#slidercta1text}}
                        <a href="{{slidercta1url}}" class="btn btn-hero-primary" target="_blank">{{slidercta1text}}</a>
                        {{/slidercta1text}}
                        {{#slidercta2text}}
                        <a href="{{slidercta2url}}" class="btn btn-hero-outline" target="_blank">{{slidercta2text}}</a>
                        {{/slidercta2text}}
                    </div>
                </div>
            </section>
        {{/slidercount}}
        
        {{! ============================== }}
        {{! GLOBAL RECOGNITION SECTION }}
        {{! ============================== }}
        {{#recognitionlogos.0}}
        <section id="recognition" class="recognition-section py-4">
            <div class="president-container-fluid">
                <div class="recognition-header text-center mb-4">
                    <h5 class="section-badge mb-3">{{#str}}globalrecognition, theme_president{{/str}}</h5>
                </div>
                <div class="logo-slider">
                    <div class="logo-track">
                        {{#recognitionlogos}}
                        <div class="logo-item">
                            <img src="{{image}}" alt="Recognition Logo">
                        </div>
                        {{/recognitionlogos}}
                        {{! Duplicate for seamless loop }}
                        {{#recognitionlogos}}
                        <div class="logo-item">
                            <img src="{{image}}" alt="Recognition Logo">
                        </div>
                        {{/recognitionlogos}}
                        {{! One more time to ensure no gaps on large screens }}
                        {{#recognitionlogos}}
                        <div class="logo-item">
                            <img src="{{image}}" alt="Recognition Logo">
                        </div>
                        {{/recognitionlogos}}
                    </div>
                </div>
            </div>
        </section>
        {{/recognitionlogos.0}}

        {{! ============================== }}
        {{! IMPACT - WHY CHOOSE US }}
        {{! ============================== }}
        <section id="impact" class="impact-section">
            <div class="president-container-fluid">
                <div class="section-header text-center">
                    <span class="section-badge">WHY PRESIDENT UNIVERSITY</span>
                    <h2 class="section-title"><span class="text-gradient" data-text="IMPACT">IMPACT</span></h2>
                    <p class="section-subtitle">Where global education, English excellence, and career purpose meet.</p>
                </div>
                <div class="row impact-grid">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">I</div>
                            <h4>International</h4>
                            <p>A global academic environment with international students and alumni from 50 countries.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">M</div>
                            <h4>Medium of Communication in English</h4>
                            <p>All learning and communication are conducted in English, ensuring global readiness.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">P</div>
                            <h4>Portfolio-Building Curriculum</h4>
                            <p>An extensive curriculum designed to help students build a strong portfolio for future careers or graduate studies.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">A</div>
                            <h4>Absolutely Worth It, Value for Money</h4>
                            <p>An educational investment that offers optimal benefits and strong return on value.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">C</div>
                            <h4>Culture: Creating Moments of Happiness</h4>
                            <p>A vibrant campus culture that nurtures happiness, creativity, and lifelong friendships.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="impact-card">
                            <div class="impact-letter">T</div>
                            <h4>Targeted Career Preparation</h4>
                            <p>A focused career development approach that prepares students with practical skills and industry-relevant experience aligned to their future professions.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ============================== }}
        {{! MARKETING BOXES / FACULTIES }}
        {{! ============================== }}
        {{#displaymarketingbox}}
            <section id="feature" class="feature-section">
                <div class="president-container-fluid">
                    <div class="section-header text-center">
                        <span class="section-badge">ACADEMIC PROGRAMS</span>
                        <h2 class="section-title">{{{marketingheading}}}</h2>
                        <div class="marketing-content">{{{marketingcontent}}}</div>
                    </div>
                    <div class="row justify-content-center">
                        {{#marketingboxes}}
                            <div class="col-sm-6 col-lg-3 mb-4">
                                <div class="faculty-card">
                                    <div class="faculty-icon">
                                        <img src="{{{icon}}}" class="rounded" alt="{{{heading}}}">
                                    </div>
                                    <h5>{{{heading}}}</h5>
                                </div>
                            </div>
                        {{/marketingboxes}}
                    </div>
                </div>
            </section>
        {{/displaymarketingbox}}

        {{! ============================== }}
        {{! NUMBERS / STATS SECTION }}
        {{! ============================== }}
        {{#numbersfrontpage}}
            <section id="numbers" class="stats-section">
                <div class="president-container-fluid">
                    <div class="row align-items-center">
                        <div class="col-xl-5 col-lg-5 col-md-12 mb-4 mb-lg-0">
                            <div class="stats-content">
                                {{{numberscontent}}}
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-7 col-md-12 offset-xl-1">
                            <div class="row">
                                <div class="col-sm-6 mb-4">
                                    <div class="stat-card stat-primary">
                                        <div class="stat-icon"><i class="fa fa-users"></i></div>
                                        <h3>{{{numbersusers}}}</h3>
                                        <p>{{#str}}numbersusers, theme_president{{/str}}</p>
                                    </div>
                                </div>
                                <div class="col-sm-6 mb-4">
                                    <div class="stat-card stat-dark">
                                        <div class="stat-icon"><i class="fa fa-book"></i></div>
                                        <h3>{{{numberscourses}}}</h3>
                                        <p>{{#str}}numberscourses, theme_president{{/str}}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        {{/numbersfrontpage}}

        {{! ============================== }}
        {{! MAIN CONTENT (COURSES) }}
        {{! ============================== }}
        <div id="topofscroll">
            <div id="page-content" class="d-print-block main-inner">
                <div id="region-main-box">
                    <section id="region-main" aria-label="{{#str}}content{{/str}}">
                        {{{ output.course_content_header }}}
                        {{{ output.main_content }}}
                        {{{ output.course_content_footer }}}
                    </section>
                </div>
            </div>
        </div>



        {{! ============================== }}
        {{! FAQ SECTION }}
        {{! ============================== }}
        {{#faqenabled}}
            <section id="faq" class="faq-section">
                <div class="president-container-fluid">
                    <div class="section-header text-center">
                        <span class="section-badge">HELP CENTER</span>
                        <h2 class="section-title">{{#str}}faq, theme_president{{/str}}</h2>
                    </div>

                    <div class="accordion faq-accordion" id="accordionFaq">
                        {{#faq}}
                            <div class="faq-item">
                                <div class="faq-header" id="heading-{{{id}}}">
                                    <button class="faq-question collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{{id}}}" aria-expanded="false" aria-controls="collapse-{{{id}}}">
                                        {{{question}}}
                                        <span class="faq-icon"><i class="fa fa-chevron-down"></i></span>
                                    </button>
                                </div>
                                <div id="collapse-{{{id}}}" class="collapse" aria-labelledby="heading-{{{id}}}" data-bs-parent="#accordionFaq">
                                    <div class="faq-answer">
                                        {{{answer}}}
                                    </div>
                                    </div>
                                </div>
                            </div>
                        {{/faq}}
                    </div>
                </div>
            </section>
        {{/faqenabled}}

        {{> theme_president/footer }}
    </div>
    
    {{{ output.standard_after_main_region_html }}}
</div>
</body>
<script>
document.addEventListener("DOMContentLoaded", function() {
    // Hero slider is now just images with CTA buttons.
});
</script>
</html>


{{#js}}
    M.util.js_pending('theme_boost/loader');
    require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
        Drawer.init();
        M.util.js_complete('theme_boost/loader');
    });
{{/js}}
