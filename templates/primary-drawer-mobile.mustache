{{< theme_boost/drawer}}
    {{$id}}theme_president-drawers-primary{{/id}}
    {{$drawerclasses}}drawer drawer-left{{/drawerclasses}}
    {{$drawercontent}}
        <div class="list-group list-group-flush">
            {{^is_guest}}
            {{#mobileprimarynav}}
                {{#haschildren}}
                    <a id="drop-down-{{key}}" href="#" class="list-group-item list-group-item-action icons-collapse-expand collapsed d-flex align-items-center justify-content-between" data-bs-toggle="collapse" data-bs-target="#drop-down-menu-{{key}}" aria-expanded="false" aria-controls="drop-down-menu-{{key}}">
                        <span class="text-truncate mr-2">{{{text}}}</span>
                        <div class="d-flex align-items-center">
                            <span class="expanded-icon icon-no-margin ml-2">
                                <i class="icon fa fa-chevron-down fa-fw " aria-hidden="true"></i>
                            </span>
                            <span class="collapsed-icon icon-no-margin ml-2">
                                <i class="icon fa fa-chevron-right fa-fw " aria-hidden="true"></i>
                            </span>
                        </div>
                    </a>
                    <div class="collapse list-group-item p-0 border-0" id="drop-down-menu-{{key}}">
                        <div class="list-group list-group-flush ml-3">
                            {{#children}}
                                <a href="{{{url}}}" class="list-group-item list-group-item-action border-0 py-2 rounded">{{{text}}}</a>
                            {{/children}}
                        </div>
                    </div>
                {{/haschildren}}
                {{^haschildren}}
                    <a href="{{{url}}}" class="list-group-item list-group-item-action">{{{text}}}</a>
                {{/haschildren}}
            {{/mobileprimarynav}}
            {{/is_guest}}

            {{#is_guest}}
            <div class="mt-2 mb-2">
                <div class="list-group list-group-flush mt-2">
                    {{#guest_links}}
                    <a href="{{{url}}}" class="list-group-item list-group-item-action border-0 py-2 rounded d-flex align-items-center {{#isactive}}active{{/isactive}}">
                        <span class="px-2">{{title}}</span>
                    </a>
                    {{/guest_links}}
                </div>
            </div>
            {{/is_guest}}

            {{! Show Theme Switcher in mobile drawer ONLY for guests (not logged in) }}
            {{^usermenu}}
            <div class="mt-4 px-3 mb-2">
                <span class="text-uppercase small font-weight-bold text-muted">Appearance</span>
                <div class="list-group list-group-flush mt-2">
                    <a href="#" class="list-group-item list-group-item-action border-0 py-2 rounded d-flex align-items-center" data-theme-value="light">
                        <i class="fa-regular fa-sun mr-3" style="width: 20px;"></i> Light
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 py-2 rounded d-flex align-items-center" data-theme-value="dark">
                        <i class="fa-regular fa-moon mr-3" style="width: 20px;"></i> Dark
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 py-2 rounded d-flex align-items-center" data-theme-value="auto">
                        <i class="fa-solid fa-circle-half-stroke mr-3" style="width: 20px;"></i> System
                    </a>
                </div>
            </div>
            {{/usermenu}}
        </div>
    {{/drawercontent}}
    {{$drawerstate}}show-drawer-primary{{/drawerstate}}
{{/ theme_boost/drawer}}
