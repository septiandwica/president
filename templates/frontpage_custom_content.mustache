{{!
    @template theme_president/frontpage_custom_content

    Custom content section for frontpage (editable via admin settings).
}}

{{#frontpage_custom_content}}
<section class="frontpage-custom-content-section py-5">
    <div class="president-container-fluid">
        <div class="custom-content-wrapper">
            {{{frontpage_custom_content}}}
        </div>
    </div>
</section>

<style>
.frontpage-custom-content-section {
    background: var(--presuniv-gray-bg);
}

.custom-content-wrapper {
    background: #fff;
    border-radius: 20px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(15, 71, 173, 0.06);
}

.custom-content-wrapper h2 {
    color: var(--presuniv-dark);
    font-weight: 800;
    margin-bottom: 1.5rem;
}

.custom-content-wrapper p {
    color: var(--presuniv-text-light);
    line-height: 1.8;
}

@media (max-width: 768px) {
    .custom-content-wrapper {
        padding: 2rem 1.5rem;
    }
}
</style>
{{/frontpage_custom_content}}
